# Start from a known module state, the default
module reset
# Load modules

if [ -z ${MYGCC+x} ]; then module load gcc ; else module load $MYGCC ; fi
ml cpe-stack/25.03 
ml libfabric/1.22.0  
ml oneapi
ml intel-oneapi-mpi

<< ++++ 
 Compile our program.
 
 There are many ways to compile using Intel MPI.
 Here we use the "Intel Suggested" way using mpiicx
 and mpifc.  This gives us new Intel backend compilers
 with Intel MPI. mpif90 and mpicc would give us gcc
 and gfortan instead
++++

mpiicx helloc.c -o helloc
mpifc hellof.f90 -o hellof

# We run with two tasks per nodes an two tasks on one node.
for arg in "--tasks-per-node=2 -n 4 --nodes=2" "-n 2 --nodes=1 --tasks-per-node=2 --network=single_node_vni " ; do
   echo running Fortran version
   srun $arg hellof
   echo
   echo running C version
   srun $arg helloc
   echo
done

# Finally we module load cray-mpich-abi.  With this module
# loaded Intel MPI is replaced with Cray MPI without needing
# to recompile. After the load we rerun and see Cray MPI
# in the output.
# Unfortunately cray-mpich-abi is "broken." You can't load 
# it and the modules necessary to run Intel MPI programs.
#
# We have a hack...
# We module reset and then load cray-mpich-abi ;then grab the
# CRAY_LD_LIBRARY_PATH.  Next we reload the Intel environment
# and before running our program we add CRAY_LD_LIBRARY_PATH to
# LD_LIBRARY_PATH.

module reset
ml cpe-stack/25.03 intel/2025.3 craype/2.7.34 cray-mpich-abi/8.1.32
export MYLDPATH=$CRAY_LD_LIBRARY_PATH
module reset
echo $MYLDPATH
ml cpe-stack/25.03 
ml libfabric/1.22.0  
ml oneapi
ml intel-oneapi-mpi
export LD_LIBRARY_PATH=$MYLDPATH:$LD_LIBRARY_PATH

for arg in "--tasks-per-node=2 -n 4 --nodes=2" "-n 2 --nodes=1 --tasks-per-node=2" ; do
   echo running Fortran version
   srun $arg hellof
   echo
   echo running C version
   srun $arg helloc
   echo
done



